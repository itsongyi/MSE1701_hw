units metal
dimension 2
boundary p p f
atom_style atomic

# =========================
# Simulation box
# =========================

region box block 0 75 0 75 -0.5 0.5
create_box 1 box

# =========================
# Create Ar atoms
# =========================

lattice hex 3.8

region sheet block 0 75 0 75 -0.1 0.1

create_atoms 1 region sheet

mass 1 39.948

# =========================
# Lennard-Jones potential
# =========================

pair_style lj/cut 10.0

# epsilon (eV), sigma (Å)
pair_coeff 1 1 0.01032 3.405

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# =========================
# MD settings
# =========================

timestep 0.002   # 2 fs

velocity all create 300 12345 mom yes rot yes dist gaussian

fix 1 all nvt temp 300 300 0.1

# 防止z方向漂移
fix 2 all enforce2d

# =========================
# Thermodynamics
# =========================

thermo 10
thermo_style custom step temp pe ke etotal press

# =========================
# Save energies
# =========================

fix thermo_out all print 10 \
"${step} ${pe} ${ke} ${etotal} ${temp}" \
file thermo.dat screen no

# =========================
# Save coordinates + forces
# =========================

dump 1 all custom 10 md.dump \
id type x y z fx fy fz

dump_modify 1 sort id

# =========================
# Run MD
# =========================

run 20000
